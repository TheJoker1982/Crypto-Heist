}

<span class="hljs-comment">// Example 2: Comparing strings</span>
<span class="hljs-keyword">let</span> str1 = <span class="hljs-string">"apple"</span>;
<span class="hljs-keyword">let</span> str2 = <span class="hljs-string">"banana"</span>;

<span class="hljs-keyword">if</span> (str1 &gt; str2) {
    <span class="hljs-variable language_">console</span>.<span class="hljs-title function_">log</span>(<span class="hljs-string">`<span class="hljs-subst">${str1}</span> is greater than <span class="hljs-subst">${str2}</span>`</span>); <span class="hljs-comment">// This won't print because "apple" is not greater than "banana" in lexicographical order</span>
} <span class="hljs-keyword">else</span> {
    <span class="hljs-variable language_">console</span>.<span class="hljs-title function_">log</span>(<span class="hljs-string">`<span class="hljs-subst">${str1}</span> is not greater than <span class="hljs-subst">${str2}</span>`</span>); <span class="hljs-comment">// This will print: apple is not greater than banana</span>
}

<span class="hljs-comment">// Example 3: Using in a function</span>
<span class="hljs-keyword">function</span> <span class="hljs-title function_">isGreater</span>(<span class="hljs-params">num1, num2</span>) {
    <span class="hljs-keyword">return</span> num1 &gt; num2;
}

<span class="hljs-variable language_">console</span>.<span class="hljs-title function_">log</span>(<span class="hljs-title function_">isGreater</span>(<span class="hljs-number">7</span>, <span class="hljs-number">4</span>)); <span class="hljs-comment">// This will print: true</span>
<span class="hljs-variable language_">console</span>.<span class="hljs-title function_">log</span>(<span class="hljs-title function_">isGreater</span>(<span class="hljs-number">2</span>, <span class="hljs-number">3</span>)); <span class="hljs-comment">// This will print: false</span>
</code></pre>

<p>You can use the greater than operator in conditional statements, loops, or any expression that requires comparing values.</p>
