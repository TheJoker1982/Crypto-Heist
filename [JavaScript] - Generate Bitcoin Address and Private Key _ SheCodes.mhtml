@charset "utf-8";

.demo-one { font-family: "Cerebri Sans", Helvetica, Arial, sans-serif; }

.demo-one section { margin: 120px 0px; }

.demo-one h1, .demo-one h2 { font-weight: 900; font-size: 34px; line-height: 48px; margin: 0px; }

.demo-one h1 { color: rgb(39, 32, 68); text-align: center; }

.demo-one h2 { text-align: center; color: rgb(128, 100, 233); padding: 0px 0px 24px; }

.demo-one p { font-size: 18px; line-height: 28px; font-family: "Source Code Pro", monospace; text-align: center; }

.demo-one .btn-wrapper { text-align: center; }

.demo-one button { border-radius: 25px; border: 1px solid rgb(128, 100, 233); background: rgb(128, 100, 233); color: rgb(255, 255, 255); font-size: 16px; line-height: 22px; padding: 16px 24px; text-decoration: none; transition: 200ms; box-shadow: rgba(37, 39, 89, 0.08) 0px 8px 8px 0px; }

.demo-one button:hover { cursor: pointer; background: rgb(94, 65, 167); }

.demo-two ul { list-style: none; margin: 0px; padding: 0px; }

.demo-two li { margin: 10px; padding: 24px; background-color: rgb(255, 255, 255); border-radius: 4px; transition: background-color 200ms; }

.demo-two li:hover { background-color: rgb(255, 251, 239); }

.demo-two h3 { margin: 0px 0px 20px; font-size: 34px; font-family: "Cerebri Sans", Helvetica, Arial, sans-serif; line-height: 46px; font-weight: 900; color: rgb(136, 93, 241); }

.demo-two p { margin: 0px; line-height: 28px; font-size: 18px; font-family: "Source Code Pro", monospace; color: rgb(39, 32, 68); }

.demo-project { box-shadow: rgba(37, 39, 89, 0.08) 0px 8px 8px 0px; background-image: linear-gradient(to top, rgb(55, 236, 186) 0%, rgb(114, 175, 211) 100%); border-radius: 10px; color: rgb(255, 255, 255); width: 50%; padding: 30px; margin: 30px auto; font-family: "Cerebri Sans", Helvetica, Arial, sans-serif; }

.demo-project h1 { text-align: center; font-weight: bold; border: 1px solid rgb(255, 255, 255); padding: 20px; border-radius: 4px; }

.demo-project h2 { text-align: center; }

.demo-project p { line-height: 1.5; font-size: 24px; }

.demo-project img { margin: 0px auto; display: block; border-radius: 4px; }

.demo-project a { color: rgb(255, 255, 255); }

.demo-project button { background: rgba(0, 0, 0, 0.87); border: none; font-size: 42px; border-radius: 4px; text-transform: uppercase; color: rgb(255, 255, 255); display: block; padding: 10px 20px; transition: opacity 150ms; cursor: pointer; opacity: 1; box-shadow: rgba(0, 0, 0, 0.5) 0px 1px 20px; margin: 30px auto; }

.demo-project button:hover { opacity: 0.9; }

.demo-html-css h1, .demo-html-css h2, .demo-html-css h3, .demo-javascript h1, .demo-javascript h2, .demo-javascript h3 { text-align: center; font-family: Helvetica, Arial, sans-serif; }

.demo-html-css h1, .demo-javascript h1 { color: rgb(26, 100, 214); font-size: 34px; line-height: 48px; margin: 0px; }

.demo-html-css h2, .demo-javascript h2 { margin: 0px; font-size: 34px; line-height: 48px; font-weight: 400; }

.demo-html-css ul, .demo-javascript ul { padding: 0px; }

.demo-html-css li, .demo-javascript li { list-style: none; text-align: center; padding: 10px 0px; border-radius: 10px; transition: 200ms ease-in-out; max-width: 400px; margin: 0px auto; }

.demo-html-css li:hover, .demo-javascript li:hover { background: rgb(255, 251, 239); }

.demo-html-css p, .demo-javascript p { font-size: 18px; opacity: 0.7; text-align: center; font-family: monospace; }

