<pre><header><div>javascript</div> <div class="d-flex"> <i class="fas fa-copy" aria-hidden="true"></i><div class="clipboard-with-label-confirmation" data-clipboard-target="#code-627694-0">Copy code</div>
</div></header><code class="javascript hljs language-javascript" id="code-627694-0" data-highlighted="yes">&lt;!<span class="hljs-variable constant_">DOCTYPE</span> html&gt;
